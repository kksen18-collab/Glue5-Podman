{
  "name": "Glue Dev (min)",
  "image": "amazon/aws-glue-libs:5",
  "remoteUser": "hadoop",
  "containerUser": "hadoop",
  "remoteEnv": {
    "PATH": "/home/hadoop/.local/bin:${containerEnv:PATH}"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:USERPROFILE}\\.aws,target=/home/hadoop/.aws,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "AWS_PROFILE": "default",
    "AWS_DEFAULT_REGION": "us-west-2",
    "AWS_SDK_LOAD_CONFIG": "1"
  },
  "postCreateCommand": "python3 -m pip install --user -U poetry && poetry config virtualenvs.create false && poetry --version",
  "postStartCommand": "git config --global core.autocrlf true && git config --global core.filemode false && git config --global --add safe.directory /workspaces/glue",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
