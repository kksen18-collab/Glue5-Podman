{
  "name": "Glue Dev (min)",
  "image": "amazon/aws-glue-libs:5",
  "remoteUser": "hadoop",
  "containerUser": "hadoop",
  "remoteEnv": {
    "PATH": "/home/hadoop/.local/bin:${containerEnv:PATH}"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:USERPROFILE}\\.aws,target=/home/hadoop/.aws,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "AWS_PROFILE": "default",
    "AWS_DEFAULT_REGION": "us-west-2",
    "AWS_SDK_LOAD_CONFIG": "1"
  },
  "forwardPorts": [4040],
  "portsAttributes": {
    "4040": { "label": "Spark UI", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "python3 -m pip install --user -U poetry ruff && poetry config virtualenvs.create false && poetry --version",
  "postStartCommand": "git config --global core.autocrlf true && git config --global core.filemode false && git config --global --add safe.directory /workspaces/glue",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  }
}
